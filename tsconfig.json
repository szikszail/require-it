{
    "compilerOptions": {
      "lib": [
        "es6",
        "es2015.promise"
      ],
      "moduleResolution": "node16",
      "target": "es6",
      "module": "node16",
      "types": [
        "node",
        "jest"
      ],
      "isolatedModules": true,
      "noImplicitAny": true,
      "declaration": true,
      "importHelpers": true,
      "rootDir": "./src",
      "outDir": "./dist",
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "sourceMap": true
    },
    "files": [
      "./src/index.ts"
    ]
  }
